    "measure": "node scripts/measure-baseline.mjs",
    "verify:anchor": "node scripts/verify-anchor.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
