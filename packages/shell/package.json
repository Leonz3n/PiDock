{
  "name": "@pidock/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PiDock Electron shell skeleton (S1): main window, utilityProcess Node host stub, typed RPC, minimal preload bridge",
  "author": "PiDock",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "pnpm --filter @pidock/renderer build && node scripts/copy-static.mjs && tsc -p tsconfig.build.json",
    "build:supervisor:mac": "node scripts/build-service-supervisor.mjs darwin-arm64",
    "build:supervisor:win": "node scripts/build-service-supervisor.mjs win32-x64",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "versions": "electron . -- --print-versions",
    "smoke": "electron . -- --smoke",
    "smoke:s3": "node scripts/smoke-s3.mjs",
    "smoke:s4": "electron . -- --smoke-s4",
    "smoke:s5": "electron . -- --smoke-s5",
    "smoke:supervisor": "electron scripts/electron-service-supervisor-smoke.mjs",
    "smoke:recovery": "electron scripts/electron-service-recovery-smoke.mjs",
    "smoke:async-checkpoint": "electron scripts/electron-service-async-checkpoint-smoke.mjs",
    "smoke:shutdown-report": "electron scripts/electron-host-shutdown-report-smoke.mjs",
    "smoke:host-release": "electron scripts/electron-host-release-smoke.mjs",
    "smoke:active-turn-quit": "electron scripts/electron-active-turn-quit-smoke.mjs",
    "smoke:main-death": "node scripts/main-death-recovery-smoke.mjs",
    "smoke:recovery-presence": "node scripts/recovery-presence-smoke.mjs",
    "startup": "electron . -- --print-startup",
    "package:dir": "electron-builder --config electron-builder.config.cjs --dir",
    "package:mac": "electron-builder --config electron-builder.config.cjs --mac dmg --arm64",
    "package:win": "electron-builder --config electron-builder.config.cjs --win nsis --x64"
  },
  "devDependencies": {
    "@pidock/renderer": "workspace:*",
    "@types/node": "24.13.6",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.0"
  }
}
