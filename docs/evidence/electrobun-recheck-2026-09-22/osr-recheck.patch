+import { writeFile } from "node:fs/promises";
+const base="http://127.0.0.1:4319";
+const targets=async()=>await fetch("http://127.0.0.1:9222/json/list").then(r=>r.json()) as any[];
+const action=async(action:string)=>fetch(base+"/api/task-view",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({task:"A",action})});
+const wait=async(n:number)=>{for(let i=0;i<50;i++){const t=await targets();if(t.length===n)return t;await Bun.sleep(100);}throw Error("target count expected "+n);};
+const read=async(t:any)=>{const ws=new WebSocket(t.webSocketDebuggerUrl);await new Promise((res,rej)=>{ws.onopen=res;ws.onerror=rej;});const value=await new Promise<any>((res,rej)=>{const timer=setTimeout(()=>rej(Error("CDP timeout")),3000);ws.onmessage=e=>{clearTimeout(timer);res(JSON.parse(String(e.data)));};ws.send(JSON.stringify({id:1,method:"Runtime.evaluate",params:{expression:"JSON.stringify({local:localStorage.getItem('pidock-account'),cookie:document.cookie,title:document.title})",returnByValue:true}}));});ws.close();return JSON.parse(value.result.result.value);};
+const original=await wait(3);const stable=original.map(t=>t.id).sort();const rounds=[];
+for(let i=0;i<10;i++){
+ await action("reopen");const all=await wait(4);await Bun.sleep(150);
+ const a=all.find(t=>t.url.includes("task=A")&&t.url.includes("view=primary"));
+ const states=await Promise.all(all.map(async t=>({id:t.id,url:t.url,...await read(t)})));
+ if(!states.every(s=>s.local===(s.url.includes("task=A")?"task-a-popup":"task-b")))throw Error("storage mismatch");
+ await action("close");const remaining=await wait(3);
+ if(JSON.stringify(remaining.map(t=>t.id).sort())!==JSON.stringify(stable))throw Error("other targets changed");
+ rounds.push({round:i+1,closedTarget:a.id,remaining:remaining.map(t=>t.id),states});
+}
+await action("reopen");await wait(4);
+await writeFile("evidence/logs/osr-close-reopen-cycles.json",JSON.stringify({ok:true,rounds},null,2));
+console.log("OSR: 10 close/reopen cycles passed, other targets unchanged, storage preserved");
